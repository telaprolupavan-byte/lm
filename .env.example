# Copy to .env.production (or set it in your host's build settings) before deploying.
#
# VITE_SITE_URL: the site's public URL with no trailing slash, e.g. https://likitha.example.com
# (include the sub-path if the site is served from one, e.g. https://user.github.io/portfolio).
# Vite substitutes it for %VITE_SITE_URL% in index.html: the canonical link, og:url,
# og:image, twitter:image, and the JSON-LD url and image. LinkedIn, Slack and X need
# absolute URLs in these tags, so set it before sharing the link.
# Left empty (the default in .env), the tags fall back to root-relative paths and the
# build still works.
VITE_SITE_URL=https://your-domain.example
